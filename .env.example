# Copy to .env.local and fill in. Never commit .env.local.

# --- Site -------------------------------------------------------------------
# Public URL of the app. Used for auth redirects and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Phase 1) -----------------------------------------------------
# Project Settings > API. Both values are safe for the browser: access is
# enforced by Row Level Security. Never put the service_role key in a
# NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# --- Later phases (not used yet) --------------------------------------------
# Phase 3: GOOGLE_PLACES_API_KEY=
# Phase 4: ANTHROPIC_API_KEY=
# Phase 4: ANTHROPIC_MODEL_FAST=
# Phase 4: ANTHROPIC_MODEL_STRONG=
# Phase 7: payment provider keys and webhook secret
# Server-only secrets (service role, API keys) must NOT have the NEXT_PUBLIC_ prefix.
# SUPABASE_SERVICE_ROLE_KEY=
