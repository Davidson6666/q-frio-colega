# Copy to .env.local and fill in. Never commit .env.local.

# Where store data comes from:
#   overture  free, open data, no account or key (default when there is no Google key)
#   google    Google Places (New): richer data, needs a key and a billing account
# PLACES_PROVIDER=overture

# Overture only: pin a data release (format 2026-09-23.1). Empty = always the latest.
# Old releases are deleted from the bucket after a while, so a pin can stop working.
# OVERTURE_RELEASE=

# Google only. Enable "Places API (New)" and billing, then create an API key.
# Server-only: do NOT add a NEXT_PUBLIC_ prefix.
GOOGLE_PLACES_API_KEY=

# Password to enter the tool. Required in production (without it the app refuses
# every request). In development, leaving it empty disables the login.
APP_PASSWORD=

# Random secret that signs the login cookie. Required in production, at least 32
# characters, independent of the password. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it logs everyone out.
SESSION_SECRET=

# Google only: brake on paid searches per server instance per day (default 100).
# MAX_SEARCHES_PER_DAY=100

# Optional: public URL, only used for page metadata.
# NEXT_PUBLIC_SITE_URL=https://seu-dominio.com
